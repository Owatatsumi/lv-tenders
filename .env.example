# Скопируйте в .env.local и заполните значениями из Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (AI-выжимки): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# SUMMARY_MODEL=claude-haiku-5-5

# Длина одноразового кода из письма (Supabase → Authentication → Providers → Email → Email OTP Length), по умолчанию 6
# NEXT_PUBLIC_SUPABASE_OTP_LENGTH=6

# Vercel Cron (/api/cron/scrape): секрет для заголовка Authorization: Bearer <CRON_SECRET>
# Сгенерировать: openssl rand -hex 32
CRON_SECRET=
# Необязательно: сколько страниц EIS (по 20 закупок) собирать и сколько сводок делать за запуск
# CRON_SCRAPE_PAGES=2
# CRON_SUMMARY_LIMIT=40
